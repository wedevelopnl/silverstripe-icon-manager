# Enforce LF line endings
* text=auto eol=lf

# Mark generated build output
/client/dist/**   linguist-generated

# Clean package — exclude dev/build/test files from distribution

# Dotfiles and dotdirs
/.apm                    export-ignore
/.claude                 export-ignore
/.docker                 export-ignore
/.editorconfig           export-ignore
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.nvmrc                  export-ignore
/.vscode                 export-ignore

# Dev and test directories
/client/src              export-ignore
/docs                    export-ignore
/src/Dev                 export-ignore
/tests                   export-ignore

# Community / contributor docs
/CONTRIBUTING.md         export-ignore

# Dev-only YAML config (un-hides the demo admin in dev)
/_config/dev.yml         export-ignore

# Dev and build config files
/AGENTS.md               export-ignore
/apm.lock                export-ignore
/apm.yml                 export-ignore
/CLAUDE.md               export-ignore
/GEMINI.md               export-ignore
/Taskfile.yml            export-ignore
/biome.json              export-ignore
/package.json            export-ignore
/package-lock.json       export-ignore
/playwright.config.ts    export-ignore
/tsconfig.json           export-ignore
/vitest.setup.ts         export-ignore
/vite.config.ts          export-ignore
