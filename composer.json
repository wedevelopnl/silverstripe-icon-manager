{
    "name": "wedevelopnl/silverstripe-icon-manager",
    "description": "Silverstripe module to upload and manage custom icons to use in SilverStripe",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe"
    ],
    "license": "BSD-3-Clause",
    "authors": [{
        "name": "WeDevelop",
        "email": "development@wedevelop.nl"
    }],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/admin": "^3.0",
        "silverstripe/asset-admin": "^3.0",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "wedevelopnl/silverstripe-svg-image": "^6.0@dev"
    },
    "_comment_require_dev": "silverstripe-e2e is needed in the HOST vendor, not just the container: tests/E2E/tsconfig.json aliases @wedevelop/e2e to vendor/wedevelopnl/silverstripe-e2e/client/playwright/index.ts, and both `npm run typecheck` and Playwright resolve it from there. Keep this pin in sync with .docker/app/composer.json.",
    "require-dev": {
        "wedevelopnl/silverstripe-e2e": "0.1.2"
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\IconManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\IconManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
