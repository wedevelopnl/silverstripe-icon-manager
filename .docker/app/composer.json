{
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "silverstripe/recipe-cms": "^6.0",
        "silverstripe/mimevalidator": "^4.0",
        "wedevelopnl/silverstripe-icon-manager": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/module",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "_comment_require_dev": "QA toolchain is pinned to exact versions so CI's lock-less `composer install` cannot silently float into a rule/behavior change that breaks the build. Runtime deps (recipe-cms) stay on ranges so the module keeps testing against the latest SS6.x. Bump these manually when adopting a new tool release. Pins must resolve on php 8.3 (the module's floor): tomasvotruba/type-coverage is held at 2.2.1 because 2.2.2 requires php ^8.4.",
    "require-dev": {
        "cambis/silverstan": "2.2.0",
        "infection/infection": "0.34.0",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.5",
        "phpstan/phpstan-deprecation-rules": "2.0.4",
        "phpunit/phpunit": "11.5.56",
        "rregeer/phpunit-coverage-check": "0.3.1",
        "tomasvotruba/type-coverage": "2.2.1",
        "wedevelopnl/silverstripe-e2e": "0.1.2",
        "wernerkrauss/silverstripe-rector": "1.3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\IconManager\\Tests\\": "vendor/wedevelopnl/silverstripe-icon-manager/tests/"
        }
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
